{
  "folder": "02_Platoon_Autostart",
  "dir": "platoon_autostart",
  "id": "platoon_autostart",
  "title": "Squad+",
  "version": "1.0.4",
  "author": "Niedvin",
  "description": "Автоматичний старт взводу при готовності всіх бійців, системне сповіщення про старт та модернізований компактний інтерфейс вікна взводу, сумісний з івентовими ангарами.",
  "changes": "Прибрано дублювання підписок після бою, перепідписку після перелогіну, зайві записи конфігу під час перетягування вікна та паралельні повтори «UI зайнятий».",
  "default_checked": true,
  "clean_patterns": [
    "ua.platoon_autostart*.wotmod"
  ],
  "clean_res_mods": [
    "scripts/client/gui/mods/mod_platoon_autostart.pyc",
    "gui/gameface/_dist/production/lobby/platoon"
  ],
  "readme_features": [
    "Автоматичний вхід у бій взводу при готовності всіх гравців.",
    "Захист від подвійних кліків (кулдаун 0.5с).",
    "Дублювання кнопки \"В бій\" безпосередньо у вікні взводу.",
    "Оновлений компактний інтерфейс вікна взводу, сумісний з івентовими ангарами."
  ],
  "build": {
    "kind": "pyc",
    "source": "mods/configs/platoon_autostart/mod_platoon_autostart.py",
    "entry": "res/scripts/client/gui/mods/mod_platoon_autostart.pyc",
    "base": "mods/{ver}/ua.platoon_autostart_1.0.4.wotmod",
    "output": "build/mods/{ver}/ua.platoon_autostart_1.0.4.wotmod",
    "name": "Squad+",
    "description": "Auto-starts battle when platoon is ready, duplicates Battle button in platoon window, and fixes ready cooldown delay.",
    "extra": [
      {
        "source": "scratch/platoon_ui_edit/MembersWindow.js",
        "entry": "res/gui/gameface/_dist/production/lobby/platoon/MembersWindow/MembersWindow.js"
      },
      {
        "source": "scratch/platoon_ui_edit/MembersWindow.css",
        "entry": "res/gui/gameface/_dist/production/lobby/platoon/MembersWindow/MembersWindow.css"
      }
    ],
    "test_commands": [
      [
        "py27",
        "scratch/test_hangar_detection.py"
      ]
    ]
  },
  "files": [
    {
      "source": "build/mods/{ver}/ua.platoon_autostart_1.0.4.wotmod",
      "target": "game_files/mods/_VERSION_/ua.platoon_autostart_1.0.4.wotmod"
    },
    {
      "source": "mods/configs/platoon_autostart/config.json",
      "target": "game_files/mods/configs/platoon_autostart/config.json"
    },
    {
      "source": "mods/configs/platoon_autostart/mod_platoon_autostart.py",
      "target": "game_files/mods/configs/platoon_autostart/mod_platoon_autostart.py"
    }
  ],
  "obsolete": [
    "ua.platoon_autostart_1.0.0.wotmod",
    "ua.platoon_autostart_1.0.1.wotmod",
    "ua.platoon_autostart_1.0.2.wotmod",
    "ua.platoon_autostart_1.0.3.wotmod"
  ]
}
