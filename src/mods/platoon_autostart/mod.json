{
  "folder": "02_Platoon_Autostart",
  "dir": "platoon_autostart",
  "id": "platoon_autostart",
  "title": "Squad+",
  "version": "1.0.13",
  "author": "Niedvin",
  "description": "Автоматичний старт і компактний інтерфейс взводів у сталих режимах.",
  "changes": "Вікно Squad+ знову відкривається після створення взводу.",
  "default_checked": true,
  "clean_patterns": [
    "ua.platoon_autostart*.wotmod"
  ],
  "clean_res_mods": [
    "scripts/client/gui/mods/mod_platoon_autostart.pyc",
    "gui/gameface/_dist/production/lobby/platoon"
  ],
  "readme_features": [
    "Автоматичний вхід у бій взводу при готовності всіх гравців.",
    "Захист від подвійних кліків (кулдаун 0.5с).",
    "Дублювання кнопки \"В бій\" безпосередньо у вікні взводу.",
    "Оновлений компактний інтерфейс вікна взводу в сталих режимах."
  ],
  "build": {
    "kind": "script",
    "commands": [
      [
        "python",
        "src/mods/platoon_autostart/build.py"
      ]
    ],
    "outputs": [
      {
        "to": "build/mods/{ver}/ua.platoon_autostart_1.0.13.wotmod"
      }
    ]
  },
  "files": [
    {
      "source": "build/mods/{ver}/ua.platoon_autostart_1.0.13.wotmod",
      "target": "game_files/mods/_VERSION_/ua.platoon_autostart_1.0.13.wotmod"
    },
    {
      "source": "mods/configs/platoon_autostart/config.json",
      "target": "game_files/mods/configs/platoon_autostart/config.json"
    },
    {
      "source": "src/mods/platoon_autostart/mod_platoon_autostart.py",
      "target": "game_files/mods/configs/platoon_autostart/mod_platoon_autostart.py"
    }
  ],
  "obsolete": [
    "ua.platoon_autostart_1.0.0.wotmod",
    "ua.platoon_autostart_1.0.1.wotmod",
    "ua.platoon_autostart_1.0.2.wotmod",
    "ua.platoon_autostart_1.0.3.wotmod",
    "ua.platoon_autostart_1.0.4.wotmod",
    "ua.platoon_autostart_1.0.5.wotmod",
    "ua.platoon_autostart_1.0.6.wotmod",
    "ua.platoon_autostart_1.0.7.wotmod",
    "ua.platoon_autostart_1.0.8.wotmod",
    "ua.platoon_autostart_1.0.9.wotmod",
    "ua.platoon_autostart_1.0.10.wotmod",
    "ua.platoon_autostart_1.0.11.wotmod",
    "ua.platoon_autostart_1.0.12.wotmod"
  ]
}
